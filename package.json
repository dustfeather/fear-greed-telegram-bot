{
  "name": "fear-greed-telegram-bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:config": "node scripts/generate-wrangler-config-local.js",
    "dev": "npm run dev:config && wrangler dev",
    "dev:scheduled": "npm run dev:config && wrangler dev --test-scheduled",
    "start": "npm run dev",
    "deploy": "wrangler deploy",
    "webhook:setup": "node scripts/setup-telegram-webhook.js",
    "webhook:info": "node scripts/get-telegram-webhook-info.js",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260507.1",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.90.1"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.5.0",
    "quickchart-js": "^3.1.3"
  }
}
